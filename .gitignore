# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
.env

# Distribution / packaging
*.egg-info/
dist/
build/

# Data (large raw files)
data/raw/
data/*/raw/
*.npy
*.mat

# Paper assets (PDFs, TeX, BibTeX - not for public repo)
paper/
*.pdf
*.tex
*.bib
*.bbl
*.blg
*.aux
*.log
*.out

# Figures: keep PNG, ignore PDF (publication vector format)
figures/*.pdf
!figures/*.png

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
*.env
*.key
*.pem